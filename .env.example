POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum
POSTGRES_DB=quantum_learn
DATABASE_URL=postgresql+psycopg://quantum:quantum@postgres:5432/quantum_learn
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
API_CORS_ORIGINS=*
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# qBraid: get the key from https://account.qbraid.com -> Account -> API Keys.
# Leave QBRAID_DEVICE_ID blank to use the free IonQ simulator, or set one of the
# 0-credit devices: ionq:ionq:sim:simulator, qbraid:qbraid:sim:qir, rigetti QVM.
QBRAID_API_KEY=
QBRAID_DEVICE_ID=ionq:ionq:sim:simulator
CELERY_SOFT_TIME_LIMIT=8
CELERY_HARD_TIME_LIMIT=15
API_BASE_URL=http://api:8000
STREAMLIT_API_URL=http://api:8000
BOOTSTRAP_INSTRUCTOR_EMAIL=instructor@local.dev
BOOTSTRAP_INSTRUCTOR_PASSWORD=instructor123
BOOTSTRAP_ADMIN_EMAIL=admin@local.dev
BOOTSTRAP_ADMIN_PASSWORD=admin123

# Dev only: run simulations inline instead of via a Celery worker (no Redis needed)
CELERY_TASK_ALWAYS_EAGER=false

# Optional CUDA-Q GPU backend (docs/CUDAQ_SETUP.md). Only read when the
# cudaq package is installed and a CUDA GPU is visible; the backend reports
# itself unavailable otherwise. MAX_GPU_QUBITS must fit VRAM at BOTH fp32 and
# fp64 (28 fits a 6 GB mobile RTX 4050 measured at ~6 GB free).
MAX_GPU_QUBITS=28
GPU_TEMP_LIMIT_C=80
GPU_COOLDOWN_SECONDS=3
